<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Maintenance jobs (expire, reverify weekly, merge duplicates) at 03:35. Set the
     absolute paths to your own checkout. See docs/SETUP.md ("Scheduling on macOS"). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.froyo.jobs</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/ABSOLUTE/PATH/TO/froyo/ops/froyo-jobs.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/froyo</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>35</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/froyo/logs/jobs.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/froyo/logs/jobs.log</string>
</dict>
</plist>
