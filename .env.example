# Local dev default: docker-compose.yml starts Postgres with POSTGRES_PASSWORD
# defaulting to "froyo". It is a throwaway password for a container bound to
# localhost, not a secret. Set POSTGRES_PASSWORD here to override it, and keep the
# password in DATABASE_URL in step with it.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://froyo:froyo@localhost:5432/froyo
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=
# Where capture images are written and read from. Defaults to <repo>/media.
# raw_captures.image_path is stored RELATIVE to this, so the database never
# carries one machine's directory layout.
MEDIA_ROOT=
